{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai6101:harness:schema:run-event:1",
  "title": "Run event (run-event/1)",
  "description": "One JSONL line of a harness run log. Every variant carries the same envelope and is selected by the event_type const. Version 1.",
  "oneOf": [
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/adaptation_diff" },
    { "$ref": "#/$defs/adaptation_outcome" },
    { "$ref": "#/$defs/model_call" },
    { "$ref": "#/$defs/mcp_action" },
    { "$ref": "#/$defs/canary_result" },
    { "$ref": "#/$defs/verifier_probe" },
    { "$ref": "#/$defs/verifier_verdict" },
    { "$ref": "#/$defs/metric_score" },
    { "$ref": "#/$defs/failure_category" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/run_complete" }
  ],
  "$defs": {
    "nonempty_string": { "type": "string", "minLength": 1 },
    "nullable_string": { "type": ["string", "null"] },
    "count": { "type": "integer", "minimum": 0 },
    "nullable_count": { "type": ["integer", "null"], "minimum": 0 },
    "nullable_usd": { "type": ["number", "null"], "minimum": 0 },
    "nullable_number": { "type": ["number", "null"] },
    "string_array": { "type": "array", "items": { "type": "string" } },
    "schema_version": { "const": "run-event/1" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source": { "enum": ["rust", "python"] },
    "strategy": { "enum": ["no_update", "full_rewrite", "selective_patch", null] },
    "phase": { "enum": ["adaptation", "canary", "verifier", "probe_generation", "agent", "other"] },
    "change_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "tool_id", "class", "kind", "field_path", "old_hash", "new_hash"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/nonempty_string" },
        "tool_id": { "$ref": "#/$defs/nonempty_string" },
        "class": { "enum": ["tool", "parameter", "description"] },
        "kind": { "enum": ["added", "removed", "renamed", "modified"] },
        "field_path": { "$ref": "#/$defs/nullable_string" },
        "old_hash": { "$ref": "#/$defs/nullable_string" },
        "new_hash": { "$ref": "#/$defs/nullable_string" }
      }
    },

    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "provider", "model", "judge_version", "seed", "repetition", "budget_cap_usd", "task_ids",
        "source_version", "target_version", "temperature", "top_p", "max_output_tokens"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "config" },
        "provider": { "$ref": "#/$defs/nonempty_string" },
        "model": { "$ref": "#/$defs/nonempty_string" },
        "judge_version": { "$ref": "#/$defs/nonempty_string" },
        "seed": { "$ref": "#/$defs/count" },
        "repetition": { "$ref": "#/$defs/count" },
        "budget_cap_usd": { "$ref": "#/$defs/nullable_usd" },
        "task_ids": { "$ref": "#/$defs/string_array" },
        "source_version": { "$ref": "#/$defs/nonempty_string" },
        "target_version": { "$ref": "#/$defs/nonempty_string" },
        "temperature": { "$ref": "#/$defs/nullable_number" },
        "top_p": { "$ref": "#/$defs/nullable_number" },
        "max_output_tokens": { "$ref": "#/$defs/nullable_count" }
      }
    },

    "adaptation_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "source_version", "target_version", "changes", "candidate_hash"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "adaptation_diff" },
        "source_version": { "$ref": "#/$defs/nonempty_string" },
        "target_version": { "$ref": "#/$defs/nonempty_string" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change_record" } },
        "candidate_hash": { "$ref": "#/$defs/nullable_string" }
      }
    },

    "adaptation_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "status", "reason", "candidate_hash", "prior_hash", "changed_lineage_ids"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "adaptation_outcome" },
        "status": { "enum": ["promoted", "blocked", "unchanged", "rejected"] },
        "reason": { "type": "string" },
        "candidate_hash": { "$ref": "#/$defs/nullable_string" },
        "prior_hash": { "$ref": "#/$defs/nonempty_string" },
        "changed_lineage_ids": { "$ref": "#/$defs/string_array" }
      }
    },

    "model_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "provider", "model", "phase", "request_id", "input_tokens", "output_tokens", "latency_ms",
        "rate_card_id", "rate_card_date", "estimated_usd", "cost_status"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "model_call" },
        "provider": { "$ref": "#/$defs/nonempty_string" },
        "model": { "$ref": "#/$defs/nonempty_string" },
        "phase": { "$ref": "#/$defs/phase" },
        "request_id": { "$ref": "#/$defs/nonempty_string" },
        "input_tokens": { "$ref": "#/$defs/nullable_count" },
        "output_tokens": { "$ref": "#/$defs/nullable_count" },
        "latency_ms": { "$ref": "#/$defs/count" },
        "rate_card_id": { "$ref": "#/$defs/nullable_string" },
        "rate_card_date": { "$ref": "#/$defs/nullable_string" },
        "estimated_usd": { "$ref": "#/$defs/nullable_usd" },
        "cost_status": { "enum": ["priced", "unknown", "mock", "local"] }
      }
    },

    "mcp_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "task_id", "step", "tool_id", "arguments", "result_summary", "is_error"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "mcp_action" },
        "task_id": { "$ref": "#/$defs/nonempty_string" },
        "step": { "$ref": "#/$defs/count" },
        "tool_id": { "$ref": "#/$defs/nonempty_string" },
        "arguments": { "type": "object" },
        "result_summary": { "type": "string" },
        "is_error": { "type": "boolean" }
      }
    },

    "canary_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "status", "tool_id", "probe_id", "is_control", "expected", "actual", "event_refs"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "canary_result" },
        "status": { "enum": ["pass", "fail", "inconclusive", "not_applicable"] },
        "tool_id": { "$ref": "#/$defs/nullable_string" },
        "probe_id": { "$ref": "#/$defs/nullable_string" },
        "is_control": { "type": "boolean" },
        "expected": { "$ref": "#/$defs/nullable_string" },
        "actual": { "$ref": "#/$defs/nullable_string" },
        "event_refs": { "type": "array", "items": { "$ref": "#/$defs/count" } }
      }
    },

    "verifier_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "task_id", "probe_id", "description", "observation"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "verifier_probe" },
        "task_id": { "$ref": "#/$defs/nonempty_string" },
        "probe_id": { "$ref": "#/$defs/nonempty_string" },
        "description": { "type": "string" },
        "observation": { "type": "string" }
      }
    },

    "verifier_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "task_id", "outcome", "claimed_complete", "rationale", "probe_ids"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "verifier_verdict" },
        "task_id": { "$ref": "#/$defs/nonempty_string" },
        "outcome": { "enum": ["confirmed_success", "confirmed_failure", "inconclusive"] },
        "claimed_complete": { "type": "boolean" },
        "rationale": { "type": "string" },
        "probe_ids": { "$ref": "#/$defs/string_array" }
      }
    },

    "metric_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "metric", "task_id", "value"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "metric_score" },
        "metric": { "enum": ["tf", "pe", "ecs", "recovery", "retention"] },
        "task_id": { "$ref": "#/$defs/nullable_string" },
        "value": { "type": "number" }
      }
    },

    "failure_category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "task_id", "category", "detail"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "failure_category" },
        "task_id": { "$ref": "#/$defs/nonempty_string" },
        "category": { "enum": ["under_update", "over_update"] },
        "detail": { "type": "string" }
      }
    },

    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "message", "fatal"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "error" },
        "message": { "type": "string" },
        "fatal": { "type": "boolean" }
      }
    },

    "run_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "seq", "ts", "source", "strategy", "event_type",
        "status", "detail"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/nonempty_string" },
        "seq": { "$ref": "#/$defs/count" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "strategy": { "$ref": "#/$defs/strategy" },
        "event_type": { "const": "run_complete" },
        "status": { "enum": ["ok", "failed", "cancelled", "budget_exhausted"] },
        "detail": { "$ref": "#/$defs/nullable_string" }
      }
    }
  }
}
