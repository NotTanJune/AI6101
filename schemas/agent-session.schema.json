{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai6101:harness:schema:agent-session:1",
  "title": "Agent session transcript line (agent-session/1)",
  "description": "One JSONL line of an agent session transcript (transcript.jsonl). Every variant carries schema, ts and kind; kind selects the variant. All strings are secret-redacted before writing. Version 1.",
  "oneOf": [
    {
      "$ref": "#/$defs/session_start"
    },
    {
      "$ref": "#/$defs/model_switch"
    },
    {
      "$ref": "#/$defs/user_message"
    },
    {
      "$ref": "#/$defs/assistant_message"
    },
    {
      "$ref": "#/$defs/tool_call"
    },
    {
      "$ref": "#/$defs/tool_result"
    },
    {
      "$ref": "#/$defs/approval"
    },
    {
      "$ref": "#/$defs/usage"
    },
    {
      "$ref": "#/$defs/drift"
    },
    {
      "$ref": "#/$defs/notice"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/turn_finished"
    }
  ],
  "$defs": {
    "schema_version": {
      "const": "agent-session/1"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "nullable_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nullable_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "session_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "model_alias",
        "effort"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "session_start"
        },
        "model_alias": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "$ref": "#/$defs/effort"
        }
      }
    },
    "model_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "model_alias",
        "effort"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "model_switch"
        },
        "model_alias": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "$ref": "#/$defs/effort"
        }
      }
    },
    "user_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "text"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "user_message"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "assistant_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "model_alias",
        "text",
        "tool_call_count"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "assistant_message"
        },
        "model_alias": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "tool_call_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "call_id",
        "name",
        "arguments"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "tool_call"
        },
        "call_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": true
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "call_id",
        "name",
        "output",
        "is_error",
        "duration_ms"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "tool_result"
        },
        "call_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "duration_ms": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "id",
        "tool",
        "class",
        "summary",
        "decision"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "approval"
        },
        "id": {
          "$ref": "#/$defs/count"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "read",
            "write",
            "shell",
            "mcp"
          ]
        },
        "summary": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "once",
            "session",
            "deny"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "model_alias",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cost_usd"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "usage"
        },
        "model_alias": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "$ref": "#/$defs/nullable_count"
        },
        "output_tokens": {
          "$ref": "#/$defs/nullable_count"
        },
        "cached_input_tokens": {
          "$ref": "#/$defs/nullable_count"
        },
        "cost_usd": {
          "$ref": "#/$defs/nullable_usd"
        }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "server",
        "kb_cards",
        "live_tools",
        "change_count"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "drift"
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "kb_cards": {
          "$ref": "#/$defs/count"
        },
        "live_tools": {
          "$ref": "#/$defs/count"
        },
        "change_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "text"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "notice"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "text"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "error"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "turn_finished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ts",
        "kind",
        "reason"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema_version"
        },
        "ts": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "const": "turn_finished"
        },
        "reason": {
          "enum": [
            "completed",
            "max_steps",
            "budget",
            "cancelled",
            "stalled",
            "error"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
