{
  "alpha-notes": {
    "description": "Invented note server for tests.",
    "tools": [
      {
        "name": "create_note",
        "description": "Create a note.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Title."
            },
            "body": {
              "type": "string",
              "description": "Body."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "high"
              ],
              "description": "Note priority."
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_notes",
        "description": "List notes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Max notes."
            },
            "sort": {
              "type": "string",
              "description": "Sort order."
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "notes": {
              "type": "array"
            }
          }
        }
      },
      {
        "name": "delete_note",
        "description": "Delete a note.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  },
